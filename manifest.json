{
  "manifest_version": 3,
  "name": "YouTube Original Title",
  "version": "1.0",
  "description": "يعرض العنوان الأصلي للفيديو بدلاً من العنوان المترجم.",
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}